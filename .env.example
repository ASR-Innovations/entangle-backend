NODE_ENV=development
PORT=5009
FRONTEND_URL=http://localhost:3000

# Database - PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/entangle_meetings
REDIS_URL=redis://localhost:6379

# Blockchain - Arbitrum Sepolia Testnet
BLOCKCHAIN_NETWORK=ARBITRUM_SEPOLIA
ETH_WSS_ENDPOINT=wss://sepolia-rollup.arbitrum.io/rpc
ETH_HTTP_ENDPOINT=https://sepolia-rollup.arbitrum.io/rpc
AUCTION_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE
PLATFORM_PRIVATE_KEY=your_private_key_here

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Para Wallet
PARA_API_KEY=your_para_api_key
PARA_SECRET_API_KEY=your_para_secret_api_key
PARA_ENVIRONMENT=beta
# Options: sandbox, beta, prod

# Lit Protocol
LIT_ACTION_IPFS_CID=your-lit-action-ipfs-cid
LIT_PKP_PUBLIC_KEY=0x...
LIT_NETWORK=serrano

# Jitsi Configuration
JITSI_DOMAIN=8x8.vc
JITSI_APP_ID=your_jitsi_app_id
JITSI_SECRET=your-jitsi-jwt-secret
JITSIPUBLIKKEY=your_jitsi_public_key
JITSI_PRIVATE_KEY=your_jitsi_private_key
CONTRACT_ADDRESS=0x6fD65aE833C9679cBC571581CE0f5Cd73D565796
JITSI_KID=your_jitsi_kid
PRIVATE_KEY=your_private_key

# Network URLs
AVALANCHE_URL=https://eth.llamarpc.com
ARBITRUM_SEPOLIA_URL=https://sepolia-rollup.arbitrum.io/rpc

# JaaS Subject (for JWT)
JAAS_SUB=your_jaas_subject

# Primary RPC URL - Arbitrum Sepolia testnet
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ============================================================================
# SEAPORT ORDERBOOK CONFIGURATION
# ============================================================================
# These variables configure the Seaport protocol orderbook integration
# for NFT marketplace functionality (Requirements: All)

# Seaport Contract Configuration
# SEAPORT_CONTRACT_ADDRESS: Address of the Seaport protocol contract
# Required for order validation and fulfillment tracking
# Arbitrum Sepolia: 0x0000000000000068F116a894984e2DB1123eB395 (Seaport 1.6)
SEAPORT_CONTRACT_ADDRESS=0x0000000000000068F116a894984e2DB1123eB395

# SEAPORT_CHAIN_ID: Chain ID for the blockchain network
# Required for EIP-712 signature verification
# Arbitrum Sepolia: 421614
SEAPORT_CHAIN_ID=421614

# WebSocket Configuration for Order Monitoring (Requirements 6.1-6.5)
# WS_RPC_URL: WebSocket RPC endpoint for listening to blockchain events
# Required for real-time order fulfillment tracking
# 
# ⚠️ IMPORTANT: Public WebSocket endpoints have restrictions!
# For production, use Alchemy (free tier: 300M compute units/month):
#   WS_RPC_URL=wss://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Or Infura (free tier: 100k requests/day):
#   WS_RPC_URL=wss://arbitrum-sepolia.infura.io/ws/v3/YOUR_API_KEY
WS_RPC_URL=wss://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ENABLE_ORDER_MONITORING: Enable/disable blockchain event monitoring
# Set to 'false' to disable OrderFulfillmentMonitorService if you don't have WebSocket access
# Default: false (disabled until you configure a proper WebSocket endpoint)
ENABLE_ORDER_MONITORING=false

# Cron Job Configuration (Requirements 7.1-7.5)
# ORDER_CLEANUP_CRON_SCHEDULE: Cron schedule for expired order cleanup
# Format: standard cron expression (minute hour day month weekday)
# Default: */5 * * * * (every 5 minutes)
# Examples:
#   */5 * * * * = every 5 minutes
#   */10 * * * * = every 10 minutes
#   0 * * * * = every hour
ORDER_CLEANUP_CRON_SCHEDULE=*/5 * * * *

# Platform Fee Configuration (Requirements 10.1-10.5)
# PLATFORM_FEE_RECIPIENT: Wallet address that receives platform fees
# Optional: Leave commented out to disable platform fee validation
# When enabled, all orders must include platform fee in consideration items
# Format: Ethereum address (0x followed by 40 hex characters)
# PLATFORM_FEE_RECIPIENT=0x0000000000000000000000000000000000000000

# PLATFORM_FEE_BASIS_POINTS: Platform fee as basis points (1 basis point = 0.01%)
# Required if PLATFORM_FEE_RECIPIENT is set
# Default: 250 (2.5%)
# Examples:
#   100 = 1%
#   250 = 2.5%
#   500 = 5%
#   1000 = 10%
PLATFORM_FEE_BASIS_POINTS=250
