# Server Configuration
NODE_ENV=production
PORT=5009
FRONTEND_URL=https://your-frontend-url.com

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Blockchain Configuration
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0x6783A0B48f44dd244A96e01c435CB5315C2AA5Af
PLATFORM_PRIVATE_KEY=your-platform-private-key

# Para Wallet
PARA_API_KEY=your-para-api-key
PARA_SECRET_API_KEY=your-para-secret-key
PARA_ENVIRONMENT=beta

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Jitsi Configuration
JITSI_DOMAIN=8x8.vc
JITSI_APP_ID=your-jitsi-app-id
JITSI_KID=your-jitsi-kid
JITSI_PRIVATE_KEY=your-jitsi-private-key
JAAS_SUB=your-jaas-subject
