        {
          "name": "Get Meeting Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{AUTH_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/meetings/{{ROOM_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "meetings", "{{ROOM_ID}}"]
            },
            "description": "Get specific meeting details by room ID."
          },
          "response": []
        }
      ]
    },
